# ==========================================
# TRUSTVAULT CONFIGURATION TEMPLATE
# ==========================================

# Application Port
SERVER_PORT=8080
FRONTEND_PORT=5173

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trustvault
SPRING_DATASOURCE_USERNAME=trustvault
SPRING_DATASOURCE_PASSWORD=trustvault_dev_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Local File Storage Configuration
TRUSTVAULT_STORAGE_TYPE=local
TRUSTVAULT_STORAGE_LOCAL_DIR=./storage/documents
TRUSTVAULT_STORAGE_MAX_FILE_SIZE=15MB

# AWS S3 / S3-Compatible Object Storage (Optional for production)
AWS_S3_BUCKET_NAME=trustvault-private-documents
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Security & Sessions
TRUSTVAULT_SECURITY_COOKIE_SECURE=false
TRUSTVAULT_SECURITY_COOKIE_SAMESITE=Lax
TRUSTVAULT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
